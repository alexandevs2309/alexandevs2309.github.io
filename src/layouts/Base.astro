---
import '../styles/global.css';
interface Props {
  titulo: string;
  descripcion: string;
  canonical?: string;
}
const { titulo, descripcion, canonical } = Astro.props as Props;
const p = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ['/', 'Inicio'],
  ['/lenguaje', 'Lenguaje'],
  ['/arquitectura', 'Arquitectura'],
  ['/docs', 'Documentación'],
  ['/ejemplos', 'Ejemplos'],
  ['/estado', 'Estado'],
  ['/novedades', 'Novedades'],
];
const full = titulo === 'Basilisco'
  ? 'Basilisco — Lenguaje de programación en español, desarrollado en Rust'
  : `${titulo} · Basilisco`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{full}</title>
  <meta name="description" content={descripcion}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={descripcion}>
  <meta property="og:locale" content="es_ES">
  <meta property="og:type" content="website">
  <meta property="og:image" content={new URL('/mascota.png', Astro.site).toString()}>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={full}>
  <meta name="twitter:description" content={descripcion}>
  <meta name="theme-color" content="#080C0B">
  <meta name="color-scheme" content="dark light">
  <link rel="icon" type="image/png" href="/mascota.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <script is:inline>
    (function () {
      var stored = localStorage.getItem('theme');
      var theme = stored || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'light' ? '#F4F7F5' : '#080C0B');
    })();
  </script>
</head>
<body>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <a class="skip" href="#c">Saltar al contenido</a>

  <div class="aviso" role="status">
    BASILISCO · Prototipo 0.6.0 · Perfil v0.4 acotado · Arquitectura y estado transparentes
  </div>

  <header>
    <div class="header-inner">
      <a class="logo" href="/" aria-label="Basilisco, inicio">
        <img src="/mascota.png" alt="" width="34" height="34">
        <span>Basilisco</span>
      </a>
      <nav aria-label="Principal">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={(p === href || (href !== '/' && p.startsWith(href))) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div style="display:flex; gap:.4rem; align-items:center;">
        <a class="btn ghost" href="/buscar" style="padding:.45rem .7rem; font-size:.85rem;" aria-label="Buscar">Buscar</a>
        <a class="btn s" href="/playground" style="padding:.45rem .8rem; font-size:.85rem;">Probar</a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar tema" aria-pressed="false" title="Cambiar tema">
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="c"><slot/></main>

  <footer>
    <div class="footer-inner">
      <div>
        <div class="footer-brand">
          <img src="/mascota.png" alt="" width="30" height="30">
          <span>Basilisco</span>
        </div>
        <p>Lenguaje de programación en español, desarrollado en Rust. Prototipo en evolución con arquitectura y estado transparentes.</p>
      </div>
      <div class="footer-col">
        <h3>Explorar</h3>
        <a href="/lenguaje">El lenguaje</a>
        <a href="/arquitectura">Arquitectura</a>
        <a href="/estado">Estado</a>
        <a href="/roadmap">Hoja de ruta</a>
      </div>
      <div class="footer-col">
        <h3>Aprender</h3>
        <a href="/docs">Documentación</a>
        <a href="/buscar">Buscar en docs</a>
        <a href="/ejemplos">Ejemplos</a>
        <a href="/playground">Playground</a>
        <a href="/aprender">Tutorial guiado</a>
      </div>
      <div class="footer-col">
        <h3>Recursos</h3>
        <a href="/descargar">Instalación y descargas</a>
        <a href="/cli">CLI y herramientas</a>
        <a href="/biblioteca">Biblioteca estándar</a>
        <a href="/ecosistema">Ecosistema</a>
        <a href="/glosario">Glosario</a>
      </div>
      <div class="footer-col">
        <h3>Proyecto</h3>
        <a href="/novedades">Novedades</a>
        <a href="/contribuir">Contribuir</a>
        <a href="/licencia">Licencia</a>
        <a href="/nosotros">Acerca de</a>
        <a href="/contacto">Contacto</a>
      </div>
    </div>
    <div class="footer-bottom">
      Prototipo 0.6.0 · Perfil v0.4 acotado · Construido con Astro · Contenido técnico basado en evidencia disponible
    </div>
  </footer>

  <script is:inline>
    (function () {
      var toggle = document.getElementById('theme-toggle');
      if (!toggle) return;
      var sync = function () {
        var light = document.documentElement.getAttribute('data-theme') === 'light';
        toggle.setAttribute('aria-pressed', String(light));
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', light ? '#F4F7F5' : '#080C0B');
      };
      sync();
      toggle.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        sync();
      });
    })();

    document.querySelectorAll('.anot-copy').forEach(btn => {
      btn.addEventListener('click', () => {
        var code = btn.getAttribute('data-code') || '';
        if (!navigator.clipboard || !navigator.clipboard.writeText) return;
        navigator.clipboard.writeText(code).then(() => {
          const orig = btn.textContent;
          btn.textContent = '✓ Copiado';
          setTimeout(() => (btn.textContent = orig), 1600);
        }).catch(() => {});
      });
    });

    (function () {
      var bar = document.querySelector('.reading-progress span');
      if (!bar) return;
      var set = function () {
        var doc = document.documentElement;
        var max = doc.scrollHeight - window.innerHeight;
        var p = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
        bar.style.width = p + '%';
      };
      document.addEventListener('scroll', set, { passive: true });
      window.addEventListener('resize', set);
      set();
    })();
  </script>
</body>
</html>
