---
import Base from '../layouts/Base.astro';
---
<Base titulo="Buscar" descripcion="Busca en la documentación y páginas de BASILISCO con índice generado en build.">
  <div class="page-head">
    <div class="hero-eyebrow">Buscar</div>
    <h1>Buscar en el sitio</h1>
    <p class="docs-lead">Búsqueda sobre un índice generado durante el build (páginas y capítulos principales). Filtra por categoría y consulta términos de lenguaje, CLI, estado y más.</p>
  </div>

  <div class="panel" style="max-width:56rem;">
    <label for="q" class="mono-label">Consulta</label>
    <div class="toc-search-wrap" style="margin-top:.5rem;">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
      <input id="q" type="search" placeholder="Ej. funciones, tipos, CLI, FFI, instalación, roadmap…" autocomplete="off" />
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.7rem;">
      <button class="tag ok filter is-active" data-filter="all" type="button">Todo</button>
      <button class="tag pl filter" data-filter="docs" type="button">Docs</button>
      <button class="tag pl filter" data-filter="site" type="button">Sitio</button>
    </div>
    <p id="status" class="toc-search-status" aria-live="polite"></p>
    <div id="results" class="grid-2" style="margin-top:.5rem;"></div>
    <p id="empty" class="toc-no-results" hidden>No se encontraron resultados. Prueba con otro término (ej. “variables”, “mostrar”, “módulos”).</p>
    <p id="loading" class="toc-no-results">Cargando índice…</p>
  </div>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var status = document.getElementById('status');
      var empty = document.getElementById('empty');
      var loading = document.getElementById('loading');
      var results = document.getElementById('results');
      var filters = Array.prototype.slice.call(document.querySelectorAll('.filter'));
      var data = [];
      var active = 'all';
      var norm = function (s) { return (s || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim(); };
      var cat = function (href) { return (href || '').indexOf('/docs') === 0 ? 'docs' : 'site'; };
      var esc = function (s) { return (s||'').replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c];}); };
      var snippet = function (text, term) {
        var raw = (text || '');
        if (!term) return esc(raw.slice(0, 140)) + (raw.length > 140 ? '…' : '');
        var n = norm(raw); var i = n.indexOf(term);
        if (i < 0) return esc(raw.slice(0, 140)) + (raw.length > 140 ? '…' : '');
        var start = Math.max(0, i - 40); var end = Math.min(raw.length, i + term.length + 60);
        var pre = start > 0 ? '…' : ''; var suf = end < raw.length ? '…' : '';
        return pre + esc(raw.slice(start, end)) + suf;
      };
      var render = function () {
        var term = norm(q && q.value);
        var shown = 0;
        results.innerHTML = '';
        for (var i = 0; i < data.length; i++) {
          var it = data[i];
          var c = cat(it.href);
          if (active !== 'all' && c !== active) continue;
          var hay = norm((it.title||'') + ' ' + (it.content||'') + ' ' + (it.href||''));
          if (term && hay.indexOf(term) === -1) continue;
          shown++;
          var a = document.createElement('a');
          a.className = 'link-card';
          a.href = it.href;
          a.innerHTML = '<h3>' + esc(it.title || '') + '</h3><p>' + snippet(it.content || '', term) + '</p><div class="meta"><span class="tag ' + (c==='docs'?'ok':'pl') + '">' + (c==='docs'?'Docs':'Sitio') + '</span> ' + esc(it.href || '') + '</div>';
          results.appendChild(a);
        }
        if (empty) empty.hidden = shown > 0 || !data.length;
        if (status) status.textContent = data.length ? (term || active !== 'all' ? (shown + ' resultado' + (shown===1?'':'s')) : (data.length + ' páginas indexadas')) : '';
      };
      filters.forEach(function (btn) {
        btn.addEventListener('click', function () {
          active = btn.getAttribute('data-filter') || 'all';
          filters.forEach(function(b){ b.classList.toggle('is-active', b===btn); b.classList.toggle('ok', b===btn); b.classList.toggle('pl', b!==btn); });
          render();
        });
      });
      if (q) q.addEventListener('input', render);
      fetch('/search-index.json').then(function(r){ return r.json(); }).then(function(json){
        data = Array.isArray(json) ? json : [];
        if (loading) loading.hidden = true;
        render();
      }).catch(function(){
        if (loading) loading.textContent = 'No se pudo cargar el índice de búsqueda.';
      });
    })();
  </script>
  <style>
    .filter { cursor: pointer; border: 1px solid var(--border); background: var(--surface); }
    .filter.is-active { box-shadow: var(--glow); }
  </style>
</Base>
