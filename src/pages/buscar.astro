---
import Base from '../layouts/Base.astro';
const paginas = [
  { href: '/docs', titulo: 'Documentación', desc: 'Hub de guías, lenguaje, herramientas, arquitectura y referencia.', tags: 'docs guia referencia hub' },
  { href: '/docs/introduccion', titulo: 'Introducción', desc: 'Qué es BASILISCO y cómo leer la documentación.', tags: 'introduccion alcance prototipo perfil' },
  { href: '/docs/instalacion', titulo: 'Instalación', desc: 'Disponibilidad y requisitos.', tags: 'instalar build cargo descargar' },
  { href: '/docs/primer-programa', titulo: 'Primer programa', desc: 'Hola mundo y ejecución básica.', tags: 'hola mostrar run .bsk primer' },
  { href: '/docs/guia-de-inicio', titulo: 'Guía de inicio', desc: 'Ruta recomendada para empezar.', tags: 'guia inicio empezar ruta' },
  { href: '/docs/sintaxis-basica', titulo: 'Sintaxis básica', desc: 'Estructura del lenguaje y bloques.', tags: 'sintaxis bloques sentencias' },
  { href: '/docs/variables-y-tipos', titulo: 'Variables y tipos', desc: 'sea var dato tipos primitivos y colecciones.', tags: 'variables tipos entero texto decimal logico nulo' },
  { href: '/docs/operadores-y-control', titulo: 'Operadores y control', desc: 'Operadores, condicionales y ciclos.', tags: 'operadores si mientras para cada rangos' },
  { href: '/docs/funciones', titulo: 'Funciones', desc: 'Definición, retorno y recursión.', tags: 'funcion retornar parametros cierres lambda' },
  { href: '/docs/colecciones-y-modulos', titulo: 'Colecciones y módulos', desc: 'Arreglos, listas y módulos.', tags: 'arreglo lista usar publico modulo' },
  { href: '/docs/manejo-de-errores', titulo: 'Manejo de errores', desc: 'Diagnósticos y captura experimental.', tags: 'errores intentar rescatar diagnostico' },
  { href: '/docs/cli-y-herramientas', titulo: 'CLI y herramientas', desc: 'Comandos de basilisco/bsk.', tags: 'cli run analizar formatear instalar' },
  { href: '/docs/biblioteca-estandar', titulo: 'Biblioteca estándar', desc: 'Funciones integradas conocidas.', tags: 'stdlib texto colecciones archivos math' },
  { href: '/docs/proyectos-y-paquetes', titulo: 'Proyectos y paquetes', desc: 'Manifiesto, módulos y dependencias locales.', tags: 'proyecto toml paquetes lock usar' },
  { href: '/docs/interoperabilidad-ffi', titulo: 'Interoperabilidad y FFI', desc: 'Puente C/ABI experimental.', tags: 'ffi c abi cargar llamar' },
  { href: '/docs/ejecucion-y-motores', titulo: 'Ejecución y motores', desc: 'Runtime, pipeline y evidencia.', tags: 'runtime motor pipeline arquitectura' },
  { href: '/docs/referencia-lenguaje', titulo: 'Referencia del lenguaje', desc: 'Resumen consolidado de referencia.', tags: 'referencia resumen lenguaje' },
  { href: '/docs/palabras-clave', titulo: 'Palabras clave y tipos', desc: 'Referencia rápida del lenguaje.', tags: 'keywords palabras clave tipos operadores' },
  { href: '/docs/faq', titulo: 'Preguntas frecuentes', desc: 'Dudas comunes.', tags: 'faq preguntas version' },
  { href: '/lenguaje', titulo: 'Lenguaje', desc: 'Filosofía y capacidades del lenguaje.', tags: 'sintaxis filosofia' },
  { href: '/arquitectura', titulo: 'Arquitectura', desc: 'Pipeline y componentes conocidos.', tags: 'pipeline runtime tipos' },
  { href: '/ejemplos', titulo: 'Ejemplos', desc: 'Programas anotados por niveles.', tags: 'ejemplos codigo' },
  { href: '/estado', titulo: 'Estado', desc: 'Madurez y disponibilidad pública.', tags: 'estado prototipo perfil' },
  { href: '/ecosistema', titulo: 'Ecosistema', desc: 'CLI, extensión, paquetes, FFI.', tags: 'ecosistema vscode ffi paquetes' },
  { href: '/descargar', titulo: 'Instalación y descargas', desc: 'Distribución y canales previstos.', tags: 'descargar instalar binarios' },
  { href: '/cli', titulo: 'CLI y herramientas', desc: 'Referencia de línea de comandos.', tags: 'cli comandos herramientas' },
  { href: '/biblioteca', titulo: 'Biblioteca estándar', desc: 'Referencia de biblioteca.', tags: 'biblioteca stdlib' },
  { href: '/roadmap', titulo: 'Roadmap', desc: 'Evolución conocida del proyecto.', tags: 'roadmap hoja de ruta' },
  { href: '/playground', titulo: 'Playground', desc: 'Entorno de prueba (integración pendiente).', tags: 'playground probar' },
];
---
<Base titulo="Buscar" descripcion="Busca páginas y capítulos de la documentación y el sitio de BASILISCO.">
  <div class="page-head">
    <div class="hero-eyebrow">Buscar</div>
    <h1>Buscar en el sitio</h1>
    <p class="docs-lead">Búsqueda rápida del lado del cliente sobre páginas y capítulos principales. Sin indexación externa ni servicios de terceros.</p>
  </div>

  <div class="panel" style="max-width:52rem;">
    <label for="q" class="mono-label">Consulta</label>
    <div class="toc-search-wrap" style="margin-top:.5rem;">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
      <input id="q" type="search" placeholder="Ej. funciones, CLI, tipos, instalación…" autocomplete="off" />
    </div>
    <p id="status" class="toc-search-status" aria-live="polite"></p>
    <div id="results" class="grid-2" style="margin-top:.5rem;">
      {paginas.map((p) => (
        <a class="link-card result" href={p.href} data-text={`${p.titulo} ${p.desc} ${p.tags}`}>
          <h3>{p.titulo}</h3>
          <p>{p.desc}</p>
          <div class="meta">{p.href}</div>
        </a>
      ))}
    </div>
    <p id="empty" class="toc-no-results" hidden>No se encontraron resultados.</p>
  </div>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var status = document.getElementById('status');
      var empty = document.getElementById('empty');
      var items = Array.prototype.slice.call(document.querySelectorAll('.result'));
      if (!q || !items.length) return;
      var norm = function (s) {
        return (s || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
      };
      var run = function () {
        var term = norm(q.value);
        var n = 0;
        for (var i = 0; i < items.length; i++) {
          var el = items[i];
          var text = norm(el.getAttribute('data-text'));
          var ok = !term || text.indexOf(term) !== -1;
          if (ok) { el.removeAttribute('hidden'); n++; }
          else { el.setAttribute('hidden', ''); }
        }
        if (empty) empty.hidden = n > 0;
        if (status) status.textContent = term ? (n + ' resultado' + (n === 1 ? '' : 's')) : '';
      };
      q.addEventListener('input', run);
      run();
    })();
  </script>
</Base>
