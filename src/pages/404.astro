---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada" descripcion="La página que buscas no existe en BASILISCO.">
  <div class="not-found">
    <img src="/error-404.png" alt="" width="240" height="240">
    <div class="err-badge">ERROR 404</div>
    <h1>Esta página no existe</h1>
    <p>Puede que el enlace esté mal escrito o que la página todavía no se haya creado.</p>
    <div class="actions">
      <a class="btn" href="/">Volver al inicio</a>
      <a class="btn s" href="/documentacion">Documentación</a>
    </div>
  </div>
</Base>
