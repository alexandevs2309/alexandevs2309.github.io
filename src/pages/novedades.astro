---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const novedades = (await getCollection('novedades')).sort((a,b) => (b.data.version || '').localeCompare(a.data.version || ''));
const rendered = await Promise.all(novedades.map(async (item) => ({ item, ...(await render(item)) })));
---
<Base titulo="Novedades" descripcion="Blog y changelog de BASILISCO: versiones, mejoras y anuncios del proyecto.">
  <div class="page-head">
    <div class="hero-eyebrow">Novedades</div>
    <h1>Changelog y actualizaciones</h1>
    <p class="docs-lead">Historial de versiones, mejoras del lenguaje, herramientas y documentación. Las entradas se publican conforme hay hitos verificables.</p>
    <div class="docs-actions">
      <a class="btn s" href="/rss.xml">RSS</a>
      <a class="btn ghost" href="/roadmap">Ver roadmap</a>
    </div>
  </div>

  <div class="grid-2">
    {rendered.map(({ item, Content }) => (
      <article class="panel">
        <div style="display:flex; justify-content:space-between; gap:1rem; align-items:center; flex-wrap:wrap;">
          <div class="mono-label">{item.data.tipo}</div>
          {item.data.version && <span class={`tag ${item.data.tipo === 'perfil' ? 'ok' : 'exp'}`}>{item.data.version}</span>}
        </div>
        <h2 style="margin-top:.4rem;">{item.data.titulo}</h2>
        <p style="color:var(--muted);">{item.data.resumen}</p>
        <div class="docs-content" style="margin-top:.5rem;"><Content /></div>
      </article>
    ))}
  </div>

  <section class="section-head"><h2>Próximas publicaciones</h2></section>
  <div class="grid-3">
    <div class="panel"><h3>Notas de versión</h3><p>Changelog detallado por release con cambios, correcciones y migraciones.</p><p><span class="tag pl">En preparación</span></p></div>
    <div class="panel"><h3>Anuncios técnicos</h3><p>Publicaciones sobre lenguaje, runtime, herramientas y documentación.</p><p><span class="tag pl">En preparación</span></p></div>
    <div class="panel"><h3>Hitos del roadmap</h3><p>Actualizaciones vinculadas a objetivos verificados del proyecto.</p><p><span class="tag pl">En preparación</span></p></div>
  </div>
</Base>
