---
import Base from '../layouts/Base.astro';
import Codigo from '../components/Codigo.astro';

// ── Install ──
const installClone = `cd ruta/de/la/copia/prototipo
cargo build --release
# El binario queda en target/release/basilisco`;
const installPath = `cd ruta/de/la/copia/prototipo
cargo install --path .
# Instala basilisco y el alias bsk en ~/.cargo/bin`;
const installVerify = `basilisco --version
bsk --version
basilisco --help`;

// ── First program ──
const hola = `mostrar "hola, mundo"`;
const holaRun = `basilisco run hola.bsk
# hola, mundo`;

// ── Variables ──
const varEj = `sea edad = 25               # tipo inferido: entero
sea nombre = "Ana"          # tipo inferido: texto
var precio: decimal = 9.99  # mutable, tipo obligatorio
dato pi: real = 3.1416e0    # inmutable, tipo obligatorio
const maximo: entero = 10   # inmutable (reservado)

edad = 26`;
const varError = `var x: entero = 10
x = "texto"   # error: se esperaba entero y se obtuvo texto`;
const varError2 = `dato x: entero = 10
x = 11        # error: variable inmutable (dato/const)`;

// ── Types ──
const numEj = `sea a = 42        # entero
sea b = 3.14      # decimal (escala 9)
sea c = 1e10      # real
sea d = a + 1     # entero: 43
sea e = a + b     # decimal: 45.14 (entero → decimal)`;
const logEj = `sea activo = verdadero
sea vacio = falso
sea niega = no activo          # falso
sea ambos = activo y no vacio  # verdadero
sea alguno = activo o vacio    # verdadero`;
const nuloEj = `sea ausencia = nulo
mostrar ausencia            # nulo
mostrar ausencia == nulo    # verdadero`;

// ── Texto ──
const textoEj = `sea saludo = "hola"
sea nombre = "mundo"
mostrar saludo + ", " + nombre   # hola, mundo

sea escapado = "línea1\\nlínea2"
mostrar escapado`;
const convNota = `mostrar 11               # imprime 11
mostrar 11 + 1           # imprime 12
mostrar "tengo " + 11    # error: + solo concatena texto con texto`;

// ── Operadores ──
const opEj = `sea suma = 10 + 5       # 15
sea resta = 10 - 3       # 7
sea mult = 4 * 6         # 24
sea div = 10 / 3         # 3 (entero trunca)
sea mod = 10 % 3         # 1

sea igual = 5 == 5       # verdadero
sea dist = 5 != 3        # verdadero
sea menor = 3 < 5        # verdadero
sea mayor = 3 > 5        # falso`;

// ── Funciones ──
const fnEj = `funcion saludar(nombre) {
  retornar "hola, " + nombre
}
mostrar saludar("Ana")   # hola, Ana`;
const fnTipada = `funcion dividir(a: entero, b: entero) -> entero {
  retornar a / b
}
mostrar dividir(10, 2)   # 5`;
const fnRec = `funcion factorial(n) {
  si n <= 1 {
    retornar 1
  }
  retornar n * factorial(n - 1)
}
mostrar factorial(5)   # 120`;
const fnDos = `funcion sumar(a, b) {
  retornar a + b
}
mostrar sumar(3, 4)   # 7`;
const fnMixta = `funcion f(a: entero, b) {
  retornar a
}
# error: la firma mezcla parámetros con y sin tipo`;
const fnPrimeraClase = `funcion aplicar(operacion, valor) {
  retornar operacion(valor)
}

funcion doble(n) { retornar n * 2 }
mostrar aplicar(doble, 21)   # 42`;
const ffiEj = `sea lib = cargar_ffi("./libejemplo.so")
sea total = llamar_ffi(lib, "sumar", [20, 22], "entero")
mostrar total   # 42
descargar_ffi(lib)`;

// ── Control flow ──
const siEj = `sea edad = 20
si edad >= 18 {
  mostrar "mayor de edad"
} sino si edad >= 13 {
  mostrar "adolescente"
} sino {
  mostrar "menor"
}`;
const mientrasEj = `sea contador = 1
sea total = 0
mientras contador <= 5 {
  total = total + contador
  contador = contador + 1
}
mostrar total   # 15`;

// ── Iteración ──
const paraCada = `var numeros: lista<entero> = [10, 20, 30]
para cada n en numeros {
  mostrar n
}
# 10, 20, 30`;
const rangos = `para cada i en 0..5 {
  mostrar i        # 0, 1, 2, 3, 4
}
para cada i en 1..=3 {
  mostrar i        # 1, 2, 3
}`;
const romperContinuar = `var total: entero = 0
para cada n en 0..10 {
  si n == 2 { continuar }
  si n == 5 { romper }
  total = total + n
}
mostrar total   # 8`;

// ── Ámbitos ──
const ambEj = `sea total = 0
{
  sea temporal = 100
  total = total + temporal
}
# temporal no existe aquí`;

// ── Colecciones ──
const arrEj = `var valores: arreglo<entero, 3> = [10, 20, 30]
mostrar valores[0]       # 10
valores[1] = 25
mostrar valores[1]       # 25`;
const listaEj = `var notas: lista<entero> = [8, 7, 9, 6]
notas[0] = 10
mostrar notas[0]         # 10
para cada nota en notas {
  mostrar nota
}`;
const colErr = `var a: arreglo<entero, 3> = [1, 2, 3]
mostrar a[3]
# error: índice 3 fuera de rango (tamaño 3)`;

// ── Errores ──
const errEj = `sea valor = 10
valor / 0`;
const errOut = `archivo.bsk: error de ejecución [2:1]: división entre cero`;
const tryEj = `intentar {
  var x: entero = 10 / 0
  mostrar x
} rescatar e {
  mostrar "error: " + e
}
# error: división entre cero`;
const trySinVar = `intentar {
  mostrar "intento"
} rescatar {
  mostrar "algo falló"
}`;

// ── Salida ──
const ioEj = `mostrar "con salto de línea"
mostrar_sin_salto "sin salto"
mostrar " ← misma línea"`;

// ── CLI ──
const cliCmds = `basilisco nuevo               # crea hola.bsk
basilisco nuevo proyecto app  # crea un proyecto
basilisco run programa.bsk   # ejecuta un archivo
basilisco analizar app.bsk   # analiza sin ejecutar
basilisco formatear app.bsk  # normaliza el formato
basilisco inicializar        # prepara el proyecto actual
basilisco probar             # ejecuta pruebas del proyecto
basilisco instalar           # resuelve dependencias locales
basilisco paquetes           # lista paquetes locales
basilisco demo               # demostración integrada
bsk run programa.nexo        # alias y extensión legada`;

// ── Keywords & types ──
const keywords = ['sea','var','dato','const','si','sino','mientras','funcion','retornar','mostrar','mostrar_sin_salto','verdadero','falso','nulo','y','o','no','para','cada','en','romper','continuar','intentar','rescatar'];
const types = ['entero','decimal','real','logico','texto','nulo','arreglo','lista'];
---
<Base
  titulo="Documentación"
  descripcion="Instalación, tutorial, referencia del lenguaje, CLI y preguntas frecuentes de BASILISCO."
>

  <div class="reading-progress" role="progressbar" aria-label="Progreso de lectura" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>

  <div class="page-head docs-page-head">
    <div class="hero-eyebrow">Documentación</div>
    <h1>Documentación</h1>
    <p class="docs-lead">Aprende el lenguaje paso a paso y consulta la referencia del prototipo. Empieza ejecutando tu primer programa o busca directamente un tema.</p>
    <div class="docs-actions">
      <a class="btn" href="#primer-programa">Empezar ahora <span aria-hidden="true">↓</span></a>
      <a class="btn s" href="/ejemplos">Ver ejemplos</a>
