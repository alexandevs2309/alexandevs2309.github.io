---
import Base from '../layouts/Base.astro';
import Anotado from '../components/Anotado.astro';

const ejemplo: [string, string][] = [
  ['funcion promedio(notas) {',            'Función declarada.'],
  ['  sea suma = 0',                      'Acumulador mutable.'],
  ['  sea cuenta = 0',                    'Contador.'],
  ['  para cada n en notas {',            'Iteración sobre colección (extensión experimental).'],
  ['    suma = suma + n',                 'Suma cada valor.'],
  ['    cuenta = cuenta + 1',             'Cuenta elementos.'],
  ['  }',                                 ''],
  ['  retornar suma / cuenta',            'Resultado numérico.'],
  ['}',                                   ''],
  ['mostrar promedio([8, 6, 10, 8])',     'Salida esperada: 8'],
];
---
<Base
  titulo="Basilisco"
  descripcion="Sitio oficial de BASILISCO: lenguaje de programación con sintaxis en español, documentación técnica, arquitectura conocida, ejemplos y estado transparente del prototipo."
>
  <section class="hero-rich">
    <div>
      <div class="hero-eyebrow">Prototipo 0.6.0 · Perfil v0.4 acotado · Developer-first</div>
      <h1>BASILISCO<br><em>plataforma del lenguaje</em></h1>
      <p class="hero-sub">
        Lenguaje de programación con sintaxis en español, documentado con rigor técnico: referencia, ejemplos anotados, arquitectura conocida y una separación clara entre capacidades garantizadas y experimentales.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/docs">Explorar documentación</a>
        <a class="btn s" href="/aprender">Empezar a aprender</a>
        <a class="btn ghost" href="/arquitectura">Ver arquitectura</a>
      </div>
      <p class="hero-status">
        <span class="tag ok">Perfil v0.4 garantizado</span>
        <span class="tag exp">Extensiones experimentales</span>
      </p>
    </div>
    <div class="hero-panel">
      <div class="mono-label" style="margin:0 0 .6rem .2rem;">Código de ejemplo (.bsk)</div>
      <Anotado lineas={ejemplo} titulo="promedio" />
    </div>
  </section>

  <section class="kpi-row" aria-label="Resumen del proyecto">
    <div class="kpi"><strong>0.6.0</strong><span>Versión declarada del prototipo</span></div>
    <div class="kpi"><strong>v0.4</strong><span>Perfil de conformidad aprobado y acotado</span></div>
    <div class="kpi"><strong>.bsk</strong><span>Extensión canónica del lenguaje</span></div>
    <div class="kpi"><strong>CLI + Docs</strong><span>Herramientas y referencia en evolución</span></div>
  </section>

  <section>
    <div class="section-head">
      <h2>Qué ofrece el lenguaje</h2>
      <p>Capacidades documentadas públicamente, organizadas para lectura rápida y acceso técnico.</p>
    </div>
    <div class="grid-3">
      <div class="panel"><h3>Sintaxis en español</h3><p>Palabras clave y mensajes orientados a hispanohablantes, con foco en claridad de lectura y aprendizaje.</p></div>
      <div class="panel"><h3>Tipado y diagnóstico</h3><p>Tipos base y colecciones, reglas explícitas y errores con ubicación/causa cuando aplica.</p></div>
      <div class="panel"><h3>Funciones y control</h3><p>Declaraciones, condicionales, ciclos y colecciones; extensiones avanzadas marcadas como experimentales.</p></div>
      <div class="panel"><h3>CLI y proyectos</h3><p>Comandos para ejecutar, analizar, formatear y trabajar con proyectos/módulos en estado prototipal.</p></div>
      <div class="panel"><h3>Ecosistema en formación</h3><p>Extensión VS Code disponible, formatos y herramientas documentadas con estado real.</p></div>
      <div class="panel"><h3>Transparencia técnica</h3><p>Separación explícita entre garantizado, experimental, pendiente y no confirmado públicamente.</p></div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>Rutas principales</h2>
      <p>Acceso directo a las áreas más importantes para desarrolladores y aprendizaje.</p>
    </div>
    <div class="grid-3">
      <a class="link-card" href="/lenguaje"><h3>Lenguaje</h3><p>Filosofía, sintaxis, tipos, funciones, control de flujo y límites conocidos.</p><div class="meta">Explorar →</div></a>
      <a class="link-card" href="/arquitectura"><h3>Arquitectura</h3><p>Pipeline conceptual y estado de componentes respaldados por evidencia pública.</p><div class="meta">Ver arquitectura →</div></a>
      <a class="link-card" href="/docs"><h3>Documentación</h3><p>Instalación, primer programa, referencia del lenguaje, CLI y preguntas frecuentes.</p><div class="meta">Abrir docs →</div></a>
      <a class="link-card" href="/ejemplos"><h3>Ejemplos</h3><p>Programas anotados por niveles con resultados esperados y notas de estado.</p><div class="meta">Ver ejemplos →</div></a>
      <a class="link-card" href="/ecosistema"><h3>Ecosistema</h3><p>CLI, extensión, módulos/paquetes, FFI y herramientas con disponibilidad real.</p><div class="meta">Conocer ecosistema →</div></a>
      <a class="link-card" href="/roadmap"><h3>Roadmap y novedades</h3><p>Evolución conocida del proyecto y estado de comunicación pública.</p><div class="meta">Consultar estado →</div></a>
    </div>
  </section>

  <section class="split" style="margin-top:3rem;">
    <div class="panel">
      <div class="mono-label">Garantizado (v0.4)</div>
      <h3 style="margin-top:.4rem;">Base estable del perfil</h3>
      <ul class="list-clean">
        <li><strong>Lenguaje:</strong> expresiones, variables/ámbitos, funciones declaradas con tipos opcionales.</li>
        <li><strong>Control:</strong> <code>si/sino</code>, <code>mientras</code>, texto, <code>nulo</code>.</li>
        <li><strong>Datos y errores:</strong> arreglos/listas básicas, diagnósticos con ubicación, CLI.</li>
      </ul>
    </div>
    <div class="panel">
      <div class="mono-label">Experimental / prototipo</div>
      <h3 style="margin-top:.4rem;">Capacidades en evolución</h3>
      <ul class="list-clean">
        <li><strong>Lenguaje:</strong> <code>para cada</code>, rangos, <code>intentar/rescatar</code>, funciones como valores/cierres.</li>
        <li><strong>Plataforma:</strong> biblioteca extendida, concurrencia básica, módulos/paquetes y FFI C.</li>
        <li><strong>Fuera de alcance actual:</strong> backend nativo/WASM confirmado, IDE/depurador integrado, etc.</li>
      </ul>
      <p style="margin-top:.8rem;"><a class="text-link" href="/estado">Ver detalle de alcance →</a></p>
    </div>
  </section>

  <div class="cta-band">
    <h2>Empieza con lo verificable</h2>
    <p>Aprende desde el perfil garantizado, usa ejemplos anotados y consulta la referencia antes de adoptar extensiones experimentales.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a class="btn" href="/docs/primer-programa">Primer programa</a>
      <a class="btn s" href="/aprender">Tutorial guiado</a>
      <a class="btn ghost" href="/playground">Playground</a>
    </div>
  </div>
</Base>
