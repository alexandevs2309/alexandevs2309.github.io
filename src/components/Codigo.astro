---
// Renders a <pre class="plain"><code> block safely, escaping HTML.
// Avoids Astro treating { } inside pre blocks as expressions.
const { codigo, clase = '', titulo = 'Basilisco' } = Astro.props;
const escaped = codigo
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;');
---
<div class="code-window code-reference" role="region" aria-label={`Código: ${titulo}`}>
  <div class="code-window-bar">
    <div class="anot-dots" aria-hidden="true"><span></span><span></span><span></span></div>
    <span class="code-window-title">{titulo}</span>
    <button class="anot-copy" type="button" data-code={codigo} aria-label="Copiar código">Copiar</button>
  </div>
  <div class="code-window-body">
    <pre class={`plain ${clase}`}><code set:html={escaped} /></pre>
  </div>
</div>
