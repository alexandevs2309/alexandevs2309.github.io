---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import VersionNotice from './VersionNotice.astro';
const { titulo, descripcion, seccion = 'Documentación', actual, breadcrumbs = [] } = Astro.props;
const capitulos = [
  ['Primeros pasos', [
    ['/docs/introduccion', 'Introducción'],
    ['/docs/instalacion', 'Instalación'],
    ['/docs/primer-programa', 'Primer programa'],
    ['/docs/guia-de-inicio', 'Guía de inicio'],
  ]],
  ['Lenguaje', [
    ['/docs/sintaxis-basica', 'Sintaxis básica'],
    ['/docs/variables-y-tipos', 'Variables y tipos'],
    ['/docs/operadores-y-control', 'Operadores y control'],
    ['/docs/funciones', 'Funciones'],
    ['/docs/colecciones-y-modulos', 'Colecciones y módulos'],
    ['/docs/manejo-de-errores', 'Manejo de errores'],
  ]],
  ['Herramientas y ecosistema', [
    ['/docs/cli-y-herramientas', 'CLI y herramientas'],
    ['/docs/biblioteca-estandar', 'Biblioteca estándar'],
    ['/docs/proyectos-y-paquetes', 'Proyectos y paquetes'],
    ['/docs/interoperabilidad-ffi', 'Interoperabilidad y FFI'],
  ]],
  ['Arquitectura', [
    ['/docs/ejecucion-y-motores', 'Ejecución y motores'],
  ]],
  ['Referencia', [
    ['/docs/referencia-lenguaje', 'Referencia del lenguaje'],
    ['/docs/palabras-clave', 'Palabras clave y tipos'],
    ['/docs/faq', 'Preguntas frecuentes'],
  ]],
];
const flat = capitulos.flatMap(([, items]) => items);
const idx = flat.findIndex(([href]) => href === actual);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;
const currentLabel = flat.find(([h]) => h === actual)?.[1] || titulo;
const crumbs = breadcrumbs.length ? breadcrumbs : [
  { href: '/docs', label: 'Docs' },
  { label: currentLabel },
];
---
<Base titulo={titulo} descripcion={descripcion}>
  <div class="docs-page-head">
    <div class="hero-eyebrow">Documentación · {seccion}</div>
    <Breadcrumbs items={crumbs} />
    <div style="display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; margin-bottom:.4rem;">
      <span class="tag ok">Perfil v0.4</span>
      <span class="tag exp">Prototipo 0.6.0</span>
      <span class="tag pl">Docs en evolución</span>
    </div>
    <VersionNotice />
    <h1>{titulo}</h1>
    <p class="docs-lead"><slot name="lead" /></p>
  </div>
  <div class="docs-layout docs-layout--with-toc">
    <aside class="docs-sidebar" aria-label="Capítulos de documentación">
      <details class="docs-nav-panel" open>
        <summary><span>Capítulos</span><span class="docs-nav-current">{currentLabel}</span></summary>
        <nav class="toc" aria-label="Índice de capítulos">
          {capitulos.map(([grupo, items]) => (
            <div class="toc-group">
              <span class="toc-group-title">{grupo}</span>
              {items.map(([href, label]) => (
                <a href={href} class={href === actual ? 'is-active' : ''} aria-current={href === actual ? 'page' : undefined}>{label}</a>
              ))}
            </div>
          ))}
        </nav>
      </details>
      <a class="docs-sidebar-examples" href="/docs"><span aria-hidden="true">▣</span><span><strong>Hub de docs</strong><small>Índice y accesos</small></span><span aria-hidden="true">→</span></a>
      <a class="docs-sidebar-examples" href="/buscar" style="margin-top:.5rem;"><span aria-hidden="true">⌕</span><span><strong>Buscar</strong><small>Páginas y capítulos</small></span><span aria-hidden="true">→</span></a>
    </aside>

    <article class="docs-content">
      <slot />
      {(prev || next) && (
        <nav class="docs-pagination" aria-label="Navegación entre capítulos">
          {prev ? <a class="docs-page-link docs-page-previous" href={prev[0]}><span>← Anterior</span><strong>{prev[1]}</strong></a> : <a class="docs-page-link" hidden href="#"></a>}
          {next ? <a class="docs-page-link docs-page-next" href={next[0]}><span>Siguiente</span><strong>{next[1]}</strong><span>→</span></a> : <a class="docs-page-link" hidden href="#"></a>}
        </nav>
      )}
    </article>

    <aside class="docs-onpage" aria-label="En esta página">
      <div class="docs-onpage-inner">
        <div class="toc-group-title" style="margin:0 0 .4rem;">En esta página</div>
        <nav id="onpage-nav" class="toc" style="border-left:0; box-shadow:none; padding:.2rem 0; background:transparent;"></nav>
      </div>
    </aside>
  </div>

  <script is:inline>
    (function () {
      const content = document.querySelector('.docs-content');
      const nav = document.getElementById('onpage-nav');
      if (!content || !nav) return;

      const slug = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');
      const headings = Array.from(content.querySelectorAll('h2, h3')).filter(h => h.textContent && h.textContent.trim());
      const used = new Set();
      headings.forEach((h) => {
        if (!h.id) {
          let id = slug(h.textContent || 'seccion');
          let i = 2;
          while (used.has(id) || document.getElementById(id)) { id = slug(h.textContent || 'seccion') + '-' + i++; }
          h.id = id;
        }
        used.add(h.id);
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent || '';
        a.style.paddingLeft = h.tagName === 'H3' ? '1rem' : '.45rem';
        a.style.fontSize = h.tagName === 'H3' ? '.78rem' : '.82rem';
        nav.appendChild(a);
      });
      if (!headings.length) {
        const wrap = document.querySelector('.docs-onpage');
        if (wrap) wrap.style.display = 'none';
      }

      const links = Array.from(nav.querySelectorAll('a'));
      const setActive = () => {
        let current = headings[0];
        const y = 120;
        for (const h of headings) {
          const top = h.getBoundingClientRect().top;
          if (top - y <= 0) current = h; else break;
        }
        links.forEach(l => {
          const on = current && l.getAttribute('href') === '#' + current.id;
          l.classList.toggle('is-active', !!on);
          if (on) l.setAttribute('aria-current','location'); else l.removeAttribute('aria-current');
        });

      };
      document.addEventListener('scroll', setActive, { passive: true });
      window.addEventListener('resize', setActive);
      setActive();
    })();
  </script>
</Base>
