{
  "name": "Basilisco",
  "scopeName": "source.basilisco",
  "fileTypes": ["bsk", "nexo"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#booleans-null" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.basilisco",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.basilisco",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.basilisco",
              "match": "\\\\(?:[\"\\\\nrt])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.real.basilisco",
          "match": "\\b\\d+\\.\\d+[eE][+-]?\\d+\\b|\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.decimal.basilisco",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.basilisco",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.basilisco",
          "match": "\\b(si|sino)\\b"
        },
        {
          "name": "keyword.control.loop.basilisco",
          "match": "\\b(mientras|para|cada|romper|continuar)\\b"
        },
        {
          "name": "keyword.control.error.basilisco",
          "match": "\\b(intentar|rescatar)\\b"
        },
        {
          "name": "keyword.declaration.basilisco",
          "match": "\\b(sea|var)\\b"
        },
        {
          "name": "keyword.other.function.basilisco",
          "match": "\\b(funcion|retornar|mostrar)\\b"
        },
        {
          "name": "keyword.operator.logical.basilisco",
          "match": "\\b(y|o|no)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.basilisco",
          "match": "\\b(entero|decimal|real|logico|texto|nulo|arreglo|lista)\\b"
        }
      ]
    },
    "booleans-null": {
      "patterns": [
        {
          "name": "constant.language.boolean.basilisco",
          "match": "\\b(verdadero|falso)\\b"
        },
        {
          "name": "constant.language.null.basilisco",
          "match": "\\bnulo\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.basilisco",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.basilisco",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.basilisco",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.basilisco",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.basilisco",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.basilisco",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.basilisco",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.colon.basilisco",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.basilisco",
          "match": ","
        }
      ]
    }
  }
}
